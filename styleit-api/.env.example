# Copy this file to a new file named  .env  (same folder) and fill in your own values.
# Never share .env or commit it. It holds secrets.

# Email for Forgot Password. See SETUP-EMAIL.md
# EASIEST (no phone, no Gmail setup): remove the # on the next line. Emails go to a free test inbox
# and the backend terminal prints a link to read each one.
# MAIL_MODE=preview

# Or real emails through Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-letter-app-password
